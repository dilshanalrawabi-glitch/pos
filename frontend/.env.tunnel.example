# Vite loads .env.development.local during `npm run dev`. bootstrap.ps1 writes that file.
# Copy to .env.development.local and edit, or run .\bootstrap.ps1 from cloudflare-tunnel.

VITE_TUNNEL_FRONTEND_HOST=pos.your-domain.com
VITE_TUNNEL_API_ORIGIN=https://pos-backend.your-domain.com

# Optional: full URL to PS_LAUNCHER.exe if not served from the API (defaults to VITE_API_BASE + /downloads/PS_LAUNCHER.exe).
# VITE_LAUNCHER_DOWNLOAD_URL=https://pos-backend.your-domain.com/downloads/PS_LAUNCHER.exe
