# Copy to .env on the PC that runs Flask (same machine as cloudflared → 127.0.0.1:7227).

# Database (must be reachable from that PC — not from the public internet).
# ORACLE_USER=rfim
# ORACLE_PASSWORD=rfim
# ORACLE_DSN=192.168.1.225:1521/rgc

ORACLE_USER=RFSR
ORACLE_PASSWORD=rfsr
ORACLE_DSN=192.168.1.225:1521/rgc

# Windows: folder that contains oci.dll (Oracle Instant Client). Required if oci.dll is not on PATH.
# Example: ORACLE_CLIENT_LIB_DIR=C:\oracle\instantclient_21_20

# Optional: full path to PS_LAUNCHER.exe for the login-page download link (GET /downloads/PS_LAUNCHER.exe).
# If unset, uses <repo>/launcher/dist/PS_LAUNCHER.exe when that file exists.
# LAUNCHER_EXE_PATH=D:\DiLSHAN\POS-WHOLESALE\launcher\dist\PS_LAUNCHER.exe
